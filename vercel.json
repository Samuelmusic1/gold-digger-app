{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/invest",
      "destination": "/api/invest.js"
    },
    {
      "source": "/priceStream",
      "destination": "/api/priceStream.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
